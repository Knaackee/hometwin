{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hometwin.dev/schema/object.schema.json",
  "title": "HomeTwin library object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "category",
    "dimensions",
    "mount",
    "license",
    "author",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(generic|manufacturers/[a-z0-9-]+)(/[a-z0-9-]+)+$",
      "description": "Path of the object folder below library/"
    },
    "name": {
      "$ref": "#/definitions/i18n",
      "description": "Display name, at least English"
    },
    "description": {
      "$ref": "#/definitions/i18nText"
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$",
      "description": "e.g. furniture/seating, lighting/floor, climate/radiator"
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "variant": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "d",
        "h"
      ],
      "description": "Outer size in metres at the default parameters: width (x), depth (z), height (y)",
      "properties": {
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "d": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        }
      }
    },
    "mount": {
      "enum": [
        "floor",
        "wall",
        "ceiling",
        "roof",
        "outdoor",
        "table",
        "opening"
      ],
      "description": "Where the panel places it. Wall: back at -d/2 touches the wall. Ceiling: top touches the ceiling."
    },
    "ha": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "uniqueItems": true
        },
        "device_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "maxItems": 20,
      "uniqueItems": true
    },
    "license": {
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "GitHub handle of the contributor"
    },
    "generated_by": {
      "type": "string",
      "maxLength": 120,
      "description": "Tool or agent that produced the recipe"
    },
    "sources": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "type"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "type": {
            "enum": [
              "product",
              "datasheet",
              "image",
              "manual",
              "other"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "opening": {
      "enum": [
        "door",
        "window"
      ],
      "description": "Wall-opening recipe contract v1: fixed group and optional leaf group; dimensions are the rough opening."
    }
  },
  "definitions": {
    "i18n": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "i18nText": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    }
  }
}
