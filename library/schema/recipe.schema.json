{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hometwin.dev/schema/recipe.schema.json",
  "title": "HomeTwin recipe",
  "description": "Declarative model built from primitives. Numbers may be expressions over params, derived values and repeat variables (e.g. \"w/2 - 0.03\").",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parts"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "params": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "default"
            ],
            "properties": {
              "default": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              },
              "type": {
                "enum": [
                  "number",
                  "int",
                  "color",
                  "bool"
                ]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "label": {
                "type": "object",
                "required": [
                  "en"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "derived": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/num"
      }
    },
    "materials": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^(#[0-9a-fA-F]{6}|\\$[a-z][a-zA-Z0-9_]*)$"
          },
          "shade": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "rough": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metal": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "emissive": {
            "type": "string",
            "pattern": "^(#[0-9a-fA-F]{6}|\\$[a-z][a-zA-Z0-9_]*)$"
          },
          "emissiveIntensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "glow": {
            "type": "boolean",
            "description": "Light source surface, driven by the entity state in the panel"
          },
          "double": {
            "type": "boolean"
          }
        }
      }
    },
    "parts": {
      "$ref": "#/definitions/parts"
    }
  },
  "definitions": {
    "num": {
      "type": [
        "number",
        "string"
      ]
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/num"
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {
        "$ref": "#/definitions/part"
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape"
      ],
      "properties": {
        "shape": {
          "enum": [
            "box",
            "cylinder",
            "cone",
            "sphere",
            "dome",
            "torus",
            "lathe",
            "extrude",
            "tube",
            "screen",
            "group"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "mat": {
          "type": "string"
        },
        "pos": {
          "$ref": "#/definitions/vec3"
        },
        "rot": {
          "$ref": "#/definitions/vec3",
          "description": "Degrees, order Y then X then Z"
        },
        "mirror": {
          "enum": [
            "x",
            "z",
            "xz"
          ]
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n"
          ],
          "properties": {
            "n": {
              "$ref": "#/definitions/num"
            },
            "var": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9_]*$"
            }
          }
        },
        "when": {
          "$ref": "#/definitions/num"
        },
        "let": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/num"
          },
          "description": "Helper values computed per copy (after repeat), usable in this part"
        },
        "size": {
          "$ref": "#/definitions/vec3"
        },
        "round": {
          "$ref": "#/definitions/num"
        },
        "r": {
          "$ref": "#/definitions/num"
        },
        "rTop": {
          "$ref": "#/definitions/num"
        },
        "rBottom": {
          "$ref": "#/definitions/num"
        },
        "h": {
          "$ref": "#/definitions/num"
        },
        "tube": {
          "$ref": "#/definitions/num"
        },
        "arc": {
          "$ref": "#/definitions/num"
        },
        "seg": {
          "$ref": "#/definitions/num"
        },
        "open": {
          "type": "boolean"
        },
        "profile": {
          "type": "array",
          "minItems": 2,
          "maxItems": 200,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/definitions/num"
            }
          }
        },
        "depth": {
          "$ref": "#/definitions/num"
        },
        "bevel": {
          "$ref": "#/definitions/num"
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/vec3"
          }
        },
        "smooth": {
          "type": "boolean"
        },
        "parts": {
          "$ref": "#/definitions/parts"
        },
        "w": {
          "$ref": "#/definitions/num",
          "description": "screen: width (m)"
        },
        "radius": {
          "$ref": "#/definitions/num",
          "description": "screen: curvature radius in m (0 = flat, e.g. 4.2 for a curved TV)"
        },
        "role": {
          "enum": [
            "screen"
          ],
          "description": "Function of this part in HomeTwin. \"screen\": the panel shows live content of a bound entity on it (media artwork, camera, image). Parts with a role are not merged."
        }
      }
    }
  }
}
